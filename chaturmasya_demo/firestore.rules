rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // EXISTING SEVA BOOKINGS
    // ============================================================

    match /bookings/{bookingId} {
      allow read, write: if true;
    }


    // ============================================================
    // COUNTERS
    // ============================================================

    match /counters/{counterId} {
      allow read, write: if true;
    }


    // ============================================================
    // VIRTUAL BOOKINGS / PADA POOJA
    // ============================================================

    match /virtualBookings/{bookingId} {
      allow read, write: if true;
    }


    // ============================================================
    // MANTRAKSHATA
    // ============================================================

    match /mantrakshata/{docId} {
      allow read, write: if true;
    }


    // ============================================================
    // DAILY SCHEDULE
    // ============================================================

    match /schedules/{docId} {
      allow read, write: if true;
    }
 

    // ============================================================
    // BLOGS
    // ============================================================

    match /blogs/{docId} {
  allow read, write: if true;

  // Blog comments
  match /comments/{commentId} {
    allow read, write: if true;
  }
}


    match /culturalRequests/{requestId} {
      allow read, write: if true;
    }



    match /culturalAvailability/{dateId} {
      allow read, write: if true;
    }


    match /culturalCalendar/{dateId} {
      allow read, write: if true;
    }
    
    match /siteStats/{documentId} {
  // Public website can display the visitor count
      allow read: if true;

      // Updates happen only through Cloud Functions/Admin SDK
      allow write: if false;
    }
    
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}